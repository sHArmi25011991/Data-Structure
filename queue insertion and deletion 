#include <stdio.h>
#include <stdlib.h>

int* queue;
int front = -1;
int rear = -1;

void enqueue(int x, int N) {
    if ((front == 0 && rear == N - 1) || (front == rear + 1)) {
        printf("OVERFLOW\n");
        return;
    }
    if (front == -1) {
        front = 0;
        rear = 0;
    } else if (rear == N - 1 && front != 0) {
        rear = 0;
    } else {
        rear++;
    }
    queue[rear] = x;
    printf("Inserted %d into the queue\n", x);
}

void dequeue(int N) {
    if (front == -1) {
        printf("UNDERFLOW\n");
        return;
    }
    printf("Deleted %d from the queue\n", queue[front]);
    if (front == rear) {
        front = -1;
        rear = -1;
    } else if (front == N - 1) {
        front = 0;
    } else {
        front++;
    }
}

void display() {
    if (front == -1) {
        printf("Queue is empty\n");
        return;
    }
    int i = front;
    while (1) {
        printf("%d ", queue[i]);
        if (i == rear) break;
        i = (i + 1) % N;
    }
    printf("\n");
}

int main() {
    int N;
    printf("Enter the size of the queue: ");
    scanf("%d", &N);
    queue = (int*)malloc(N * sizeof(int));
    int t;
    printf("Enter the number of operations: ");
    scanf("%d", &t);
    while (t--) {
        int choice, x;
        printf("Enter 1 to enqueue, 2 to dequeue: ");
        scanf("%d", &choice);
        if (choice == 1) {
            printf("Enter the element: ");
            scanf("%d", &x);
            enqueue(x, N);
        } else if (choice == 2) {
            dequeue(N);
        }
        display();
    }
    free(queue);
    return 0;
}
