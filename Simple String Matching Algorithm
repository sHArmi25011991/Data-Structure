#include <stdio.h>
#include <string.h>

int simpleStringMatching(char T[], char P[]) {
    int S = strlen(T);
    int R = strlen(P);
    for (int i = 0; i <= S - R; i++) {
        int j;
        for (j = 0; j < R; j++) {
            if (T[i + j] != P[j]) {
                break;
            }
        }
        if (j == R) {
            return i + 1;  // Return 1-based index
        }
    }
    return 0;
}

int main() {
    char T[100], P[100]; // Assuming the strings are not longer than 100 characters.
    printf("Enter the main string (T): ");
    scanf("%s", T);
    printf("Enter the pattern string (P): ");
    scanf("%s", P);
    int index = simpleStringMatching(T, P);
    if (index == 0) {
        printf("Pattern not found in the main string.\n");
    } else {
        printf("Pattern found at position: %d\n", index);
    }
    return 0;
}
